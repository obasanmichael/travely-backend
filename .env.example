# Environment
ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FIREBASE_PROJECT_ID=travely-app-6aa48
GOOGLE_APPLICATION_CREDENTIALS_JSON=
RATE_LIMIT_PER_MINUTE=30
DOCS_ENABLED=true

# Set AUTH_DISABLED=true only for local dev without Firebase Admin credentials
AUTH_DISABLED=false

# Render: set PYTHON_VERSION=3.11.11 (see runtime.txt). Required for numpy/scikit-learn pins.

# Sentry (optional locally; required in staging/production)
SENTRY_DSN=
SENTRY_RELEASE=
GIT_SHA=
